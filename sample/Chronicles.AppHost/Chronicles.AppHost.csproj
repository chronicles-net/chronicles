<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>79923f0c-5e26-4ded-bd58-036a9fa52ed0</UserSecretsId>
    <!-- Aspire CLI isn't installed/required for this project's dotnet run / IDE workflow. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chronicles.CourierApi\Chronicles.CourierApi.csproj" />
    <ProjectReference Include="..\Chronicles.OrderApi\Chronicles.OrderApi.csproj" />
    <ProjectReference Include="..\Chronicles.RestaurantApi\Chronicles.RestaurantApi.csproj" />
  </ItemGroup>

</Project>
